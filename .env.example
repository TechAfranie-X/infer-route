# InferRoute — Milestone 1
# Copy to .env for local runs outside Docker.
# Provider, routing, and cache settings are added in later milestones.

APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Local process: localhost. Inside Compose the app uses redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
