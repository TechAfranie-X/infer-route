# InferRoute — Milestone 1
# Copy to .env for local runs outside Docker.
# Provider, routing, and cache settings are added in later milestones.

APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Local process: localhost. Inside Compose the app uses redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2

PROVIDERS_CONFIG_PATH=config/providers.json
HTTP_CONNECT_TIMEOUT_SECONDS=2
HTTP_READ_TIMEOUT_SECONDS=20

# Used by `python -m app.mock`, not by the gateway process.
MOCK_PROVIDER_ID=provider-a
MOCK_LATENCY_MS=150
MOCK_FAILURE_RATE=0.02
MOCK_PORT=8081
